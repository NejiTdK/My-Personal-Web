---
/**
 * Plantilla HTML base compartida por todas las páginas.
 * Pertenece a: `src/layouts/Layout.astro` (layout raíz del sitio).
 * 
 * Props mejoradas para SEO:
 * - `title`: título de la pestaña
 * - `description`: meta descripción SEO
 * - `ogImage`: ruta a imagen Open Graph (opcional)
 * - `canonicalUrl`: URL canónica de la página (opcional)
 * - `noindex`: boolean para evitar indexación (opcional)
 * 
 * Includes: Open Graph, Twitter Cards, Schema.org, Meta tags
 */
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../config/seo';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

/** Descripción por defecto mejorada para SEO */
const { 
  title, 
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  canonicalUrl,
  noindex = false
} = Astro.props;

/** URL base - BASE_URL ya incluye el path del proyecto */
const baseUrl = import.meta.env.BASE_URL; // "/My-Personal-Web/"
const siteUrl = siteConfig.siteUrl; // "https://NejiTdK.github.io"

/** URL canónica completa */
const canonical = canonicalUrl || `${siteUrl}${baseUrl}`;

/** Imagen OG completa */
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${baseUrl}${ogImage}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteConfig.title,
  "jobTitle": siteConfig.tagline,
  "url": `${siteUrl}${baseUrl}`,
  "image": ogImageUrl,
  "description": siteConfig.description,
  "sameAs": [
    `https://github.com/${siteConfig.githubUsername}`,
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Freelance"
  }
};
---

<!doctype html>
<!-- Documento HTML5 optimizado para SEO -->
<html lang={siteConfig.language}>
  <head>
    <!-- ClientRouter (View Transitions) para animaciones suaves entre páginas -->
    <ClientRouter />

    <!-- ============================================
         META BÁSICAS
         ============================================ -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Robots (indexación) -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    
    <!-- Meta descripción (150-160 caracteres ideal) -->
    <meta name="description" content={description} />
    
    <!-- Author y keywords -->
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content="landing page, desarrollo web, HTML, CSS, JS, prototipado, sitios estáticos, portfolio" />
    
    <!-- Generator (Astro) -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- ============================================
         CANONICAL URL
         ============================================ -->
    <link rel="canonical" href={canonical} />
    
    <!-- ============================================
         SITEMAP
         ============================================ -->
    <link rel="sitemap" href={`${siteUrl}${baseUrl}sitemap.xml`} type="application/xml" />
    
    <!-- ============================================
         OPEN GRAPH (Facebook, LinkedIn, WhatsApp)
         ============================================ -->
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={siteConfig.locale} />
    
    <!-- ============================================
         TWITTER CARDS
         ============================================ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content={siteConfig.twitterHandle} />
    <meta name="twitter:site" content={siteConfig.twitterHandle} />
    
    <!-- ============================================
         FAVICON
         ============================================ -->
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}${siteConfig.favicon}`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${baseUrl}${siteConfig.favicon}`} />
    <link rel="icon" type="image/png" sizes="128x128" href={`${baseUrl}${siteConfig.favicon}`} />
    <link rel="apple-touch-icon" href={`${baseUrl}${siteConfig.favicon}`} />
    
    <!-- ============================================
         TÍTULO
         ============================================ -->
    <title>{title}</title>
    
    <!-- ============================================
         PRECONNECT (performance)
         ============================================ -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- ============================================
         SCHEMA.ORG STRUCTURED DATA
         ============================================ -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    
    <!-- Vanilla Tilt.js -->
    <script src="https://cdn.jsdelivr.net/npm/vanilla-tilt@1.8.1/dist/vanilla-tilt.min.js"></script>
  </head>
  
  <body>
    <!-- Contenido de cada página inyectado aquí -->
    <slot />
  </body>
</html>

<script>
      let scrollObserver: IntersectionObserver | null = null;

      /**
       * Scroll Reveal - Animaciones al hacer scroll
       */
      function initScrollReveal() {
        // Limpiar observer anterior si existe
        if (scrollObserver) {
          scrollObserver.disconnect();
        }

        scrollObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.reveal, .reveal-fade, .reveal-scale, .stagger-children').forEach(el => {
          scrollObserver!.observe(el);
        });
      }

/**
        * Efecto tilt 3D con VanillaTilt.js
        * Para elementos con data-tilt attribute
        */
      function initTiltCards() {
        // @ts-ignore - VanillaTilt se carga desde CDN
        if (typeof VanillaTilt !== 'undefined') {
          const tiltElements = document.querySelectorAll('[data-tilt]');
          tiltElements.forEach(el => {
            // @ts-ignore
            new VanillaTilt.init(el, {
              max: parseInt(el.getAttribute('data-tilt-max') || '10'),
              speed: parseInt(el.getAttribute('data-tilt-speed') || '400'),
              glare: el.hasAttribute('data-tilt-glare'),
              'max-glare': parseFloat(el.getAttribute('data-tilt-max-glare') || '0.3'),
            });
          });
        }
      }

      // Ejecutar en carga inicial
      document.addEventListener('DOMContentLoaded', () => {
        initScrollReveal();
        setTimeout(initTiltCards, 50);
      });

      // Ejecutar después de View Transitions
      document.addEventListener('astro:page-load', () => {
        initScrollReveal();
        setTimeout(initTiltCards, 50);
      });
    </script>

<style is:global>
  @import '../styles/global.css';
</style>
