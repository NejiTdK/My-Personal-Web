---
/**
 * Plantilla HTML base compartida por todas las páginas.
 * Pertenece a: `src/layouts/Layout.astro` (layout raíz del sitio).
 *
 * Props:
 * - `title`: título de la pestaña del navegador.
 * - `description`: meta descripción SEO (opcional).
 */
interface Props {
  title: string;
  description?: string;
}

/** Título y descripción por defecto si no se pasan desde la página. */
const { title, description = "Portafolio retro pixel art" } = Astro.props;
/** Prefijo base (importante para GitHub Pages en repos de proyecto). */
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<!-- Documento HTML5; `lang="es"` para accesibilidad e indexación en español. -->
<html lang="es">
  <head>
    <!-- Codificación y viewport estándar para responsive. -->
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon servido desde `/public` en la URL raíz del sitio. -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon-a.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Preconnect acelera la carga de la fuente pixel desde Google Fonts. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Contenido de cada página inyectado aquí mediante `<Layout>...</Layout>`. -->
    <slot />
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tiltCards = document.querySelectorAll('.tilt-card');

    tiltCards.forEach(card => {
      const handleMouseMove = (e: MouseEvent) => {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -10;
        const rotateY = ((x - centerX) / centerX) * 10;
        
        (card as HTMLElement).style.transform = 
          `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      };

      const handleMouseLeave = () => {
        (card as HTMLElement).style.transform = 
          'perspective(1000px) rotateX(0deg) rotateY(0deg)';
      };

      card.addEventListener('mousemove', handleMouseMove);
      card.addEventListener('mouseleave', handleMouseLeave);
    });
  });
</script>

<style is:global>
  /* Estilos globales del sitio (tokens, animaciones, scrollbar, etc.). */
  @import '../styles/global.css';
</style>
