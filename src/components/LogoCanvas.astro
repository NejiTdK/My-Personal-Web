  /** Convierte el ASCII en una matriz de caracteres (filas × columnas), rellenando huecos con espacio. */
  function parseAsciiArt(ascii: string): string[][] {
    const lines = ascii.split('\n').filter(l => l.length > 0);
    const maxWidth = Math.max(...lines.map(l => l.length));
    const grid: string[][] = [];
    
    for (const line of lines) {
      const row: string[] = [];
      for (let i = 0; i < maxWidth; i++) {
        row.push(line[i] || ' ');
      }
      grid.push(row);
    }
    return grid;
  }

  /** Mapa carácter → color para pintar cada celda del canvas. */
  const palette: Record<string, string> = {
    '@': '#0D8BDB',
    '#': '#06476F',
    '*': '#085a7d',
    '%': '#085a7d',
    '+': '#DDE8EB',
    ':': '#DDE8EB',
    '=': '#DDE8EB',
    '-': '#DDE8EB',
    '.': '#1a1a1a',
    ' ': '#1a1a1a',
  };

  /** Dibuja la rejilla completa en el canvas con píxeles cuadrados de tamaño `pixelSize`. */
  function renderLogo(canvas: HTMLCanvasElement, grid: string[][], pixelSize: number) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rows = grid.length;
    const cols = grid[0]?.length || 0;

    canvas.width = cols * pixelSize;
    canvas.height = rows * pixelSize;

    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const char = grid[y][x];
        ctx.fillStyle = palette[char] || '#1a1a1a';
        ctx.fillRect(x * pixelSize, y * pixelSize, pixelSize, pixelSize);
      }
    }
  }

  /** Muestrea la rejilla grande para obtener una versión más pequeña (promedio por vecino más cercano). */
  function downscaleGrid(grid: string[][], targetWidth: number, targetHeight: number): string[][] {
    const srcRows = grid.length;
    const srcCols = grid[0]?.length || 0;
    const result: string[][] = [];

    for (let y = 0; y < targetHeight; y++) {
      const row: string[] = [];
      for (let x = 0; x < targetWidth; x++) {
        const srcY = Math.floor((y / targetHeight) * srcRows);
        const srcX = Math.floor((x / targetWidth) * srcCols);
        row.push(grid[srcY]?.[srcX] || ' ');
      }
      result.push(row);
    }
    return result;
  }

  const fullGrid = parseAsciiArt(logoAscii);

  /** Inicializa cada `.logo-canvas` del documento según su `data-size`. */
  document.querySelectorAll('.logo-canvas').forEach(canvas => {
    const el = canvas as HTMLCanvasElement;
    const size = el.dataset.size;
    const ctx = el.getContext('2d');
    if (!ctx) return;

    if (size === 'small') {
      const smallGrid = downscaleGrid(fullGrid, 20, 16);
      renderLogo(el, smallGrid, 2);
    } else {
      const largeGrid = downscaleGrid(fullGrid, 45, 32);
      renderLogo(el, largeGrid, 3);
    }
  });
</script>

<style>
  /* Evita suavizado al escalar el canvas (aspecto pixel art nítido). */
  .logo-canvas {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
</style>
