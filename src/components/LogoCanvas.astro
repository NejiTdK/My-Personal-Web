---
/**
 * Logo renderizado en un `<canvas>` a partir de arte ASCII (mapa de caracteres → colores).
 * Pertenece a: `src/components/LogoCanvas.astro`.
 *
 * Estado del proyecto: no está importado en ninguna página actualmente; sirve como alternativa
 * al PNG `/logo.png` si se desea un logo 100 % generado por código.
 *
 * Props:
 * - `size`: `'small'` (rejilla 20×16, píxel 2px) o `'large'` (45×32, píxel 3px) tras downscale.
 * - `class`: clases CSS extra para el canvas.
 */
interface Props {
  size?: 'small' | 'large';
  class?: string;
}

const { size = 'small', class: className = '' } = Astro.props;
---

<!-- Cada instancia del componente debe tener un id único si hay varios del mismo tamaño en la página. -->
<canvas 
  id={`logo-canvas-${size}`}
  class={`logo-canvas ${className}`}
  data-size={size}
></canvas>

