---
/**
 * Sección “preview” de proyectos en la home (no lista proyectos aquí).
 * Pertenece a: `src/components/ProjectGallery.astro`.
 *
 * Nota: en el estado actual del repositorio este componente no está importado en `index.astro`;
 * puedes incluirlo en la página principal si quieres mostrar este bloque junto al resto.
 *
 * Propósito: título, subtítulo y botón que lleva a la página completa `/proyectos`.
 */
const baseUrl = import.meta.env.BASE_URL;
---

<section id="proyectos" class="py-20 px-4 relative">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="font-pixel text-xl md:text-2xl text-[#EDEDED] inline-block relative">
        <span class="absolute -left-6 top-1/2 -translate-y-1/2 text-[#0D8BDB]">▶</span>
        PROYECTOS
        <span class="absolute -right-6 top-1/2 -translate-y-1/2 text-[#0D8BDB] rotate-180">▶</span>
      </h2>
      <p class="font-pixel text-xs text-[#DDE8EB]/60 mt-4">
        Preview de mis trabajos recientes
      </p>
    </div>

    <div class="text-center">
      <p class="font-pixel text-sm text-[#DDE8EB]/80 mb-8">
        Explora la colección completa de mis proyectos y creaciones.
      </p>
      
      <a 
        href={`${baseUrl}proyectos/`} 
        class="inline-block px-8 py-4 bg-[#0D8BDB] hover:bg-[#1eb3ff] transition-colors font-pixel text-sm"
      >
        VER PROYECTOS →
      </a>
    </div>
  </div>
</section>
