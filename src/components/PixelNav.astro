---
const isIndex = Astro.url.pathname === import.meta.env.BASE_URL;
const baseUrl = import.meta.env.BASE_URL;
const navItems = [
  { label: 'INICIO', href: baseUrl },
  { label: 'SOBRE MÍ', href: isIndex ? '#sobre-mi' : `${baseUrl}#sobre-mi` },
  { label: 'PROYECTOS', href: `${baseUrl}proyectos/` },
];
---

<nav class="absolute top-2 sm:top-4 left-1/2 -translate-x-1/2 z-50 bg-[#000000] border-2 border-[#00E5FF] px-3 sm:px-6 py-2 sm:py-3" style="border-radius: 2px; box-shadow: 4px 4px 0 #00E5FF;">
  <div class="flex items-center justify-center gap-3 sm:gap-8">
    <a href={baseUrl} class="flex items-center gap-2 sm:gap-3 hover:scale-105 transition-transform">
      <img 
        src={`${baseUrl}logo.png`} 
        alt="AlecDev Logo"
        class="w-8 h-8 sm:w-10 sm:h-10 object-contain"
      />
      <span class="font-pixel text-xs sm:text-sm text-[#FFFFFF]">
        ALEC<span class="text-[#00E5FF]">DEV</span>
      </span>
    </a>

    <ul class="flex gap-3 sm:gap-6">
      {navItems.map((item) => (
        <li>
          <a 
            href={item.href}
            class="font-pixel text-[10px] sm:text-xs text-[#FFFFFF] hover:text-[#FFE500] transition-colors relative group"
          >
            {item.label}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#FFE500] transition-all group-hover:w-full"></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>