---
/**
 * CTA para ver proyectos - se muestra después del Stack
 * Estilo pixel vistoso con efectos y animación de pulso
 */
const baseUrl = import.meta.env.BASE_URL;
---

<!-- CTA Proyectos con animación de pulso -->
<section class="py-16 px-4">
  <div class="max-w-lg mx-auto text-center">
    <!-- Título decorativo -->
    <h2 class="font-pixel text-lg sm:text-xl text-[#00E5FF] mb-6">
      ¿QUIERES VER MÁS?
    </h2>
    
    <!-- Botón principal con efectos y pulso -->
    <a 
      href={`${baseUrl}proyectos/`}
      class="inline-block relative group"
    >
      <!-- Pulso de luz debajo -->
      <span class="absolute left-1/2 -translate-x-1/2 bottom-0 w-32 h-1 bg-[#00E5FF] rounded-full blur-md opacity-0 group-hover:opacity-100 group-hover:animate-pulse transition-all duration-500"></span>
      
      <!-- Botón principal -->
      <span class="relative block px-8 py-4 bg-[#000000] border-2 border-[#00E5FF] font-pixel text-sm sm:text-base text-[#FFFFFF] hover:text-[#00E5FF] hover:border-[#FFE500] transition-all duration-200"
        style="box-shadow: 4px 4px 0 #00E5FF; border-radius: 4px;"
      >
        <span class="relative z-10 group-hover:scale-105 transition-transform">MIS PROYECTOS →</span>
      </span>
    </a>
    
    <!-- Subtítulo decorativo -->
    <p class="font-pixel text-[10px] sm:text-xs text-[#888888] mt-4 group-hover:text-[#FFFFFF] transition-colors">
      Haz clic para explorar mi trabajo
    </p>
    
    <!-- Decoraciones pixel animadas -->
    <div class="flex justify-center gap-2 mt-6">
      <div class="w-2 h-2 bg-[#00E5FF] animate-pulse"></div>
      <div class="w-2 h-2 bg-[#FFE500] animate-pulse" style="animation-delay: 0.2s;"></div>
      <div class="w-2 h-2 bg-[#00E5FF] animate-pulse" style="animation-delay: 0.4s;"></div>
    </div>
  </div>
</section>