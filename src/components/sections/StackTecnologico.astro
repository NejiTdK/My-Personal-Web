---
/**
 * Sección de Stack Tecnológico.
 * Muestra las tecnologías usadas con iconos y descripciones estilo pixel.
 */
const tecnologias = [
  { 
    nombre: 'HTML', 
    descripcion: 'Estructura web semántica',
    color: '#E44D26'
  },
  { 
    nombre: 'CSS', 
    descripcion: 'Estilos con Tailwind',
    color: '#264DE4'
  },
  { 
    nombre: 'JS', 
    descripcion: 'Interactividad y lógica',
    color: '#F7DF1E'
  },
  { 
    nombre: 'REACT', 
    descripcion: 'Componentes reutilizables',
    color: '#61DAFB'
  },
  { 
    nombre: 'ASTRO', 
    descripcion: 'Framework estático rápido',
    color: '#FF5A1F'
  },
];
---

<!-- Stack Tecnológico -->
<section id="stack" class="py-16 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Título -->
    <h2 class="font-pixel text-lg sm:text-xl text-center text-[#00E5FF] mb-8">
      STACK TECNOLÓGICO
    </h2>
    
    <!-- Tarjeta con bordes pixelados -->
    <div 
      class="bg-[#000000] border-2 border-[#00E5FF] p-6 sm:p-8" 
      style="border-radius: 2px; box-shadow: 4px 4px 0 #00E5FF;"
    >
      <!-- Grid de tecnologías -->
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-6">
        {tecnologias.map((tech) => (
          <div class="text-center flex flex-col items-center">
            <!-- Icono pixelado -->
            <div class="w-10 h-10 mb-3">
              {tech.nombre === 'HTML' && (
                <svg viewBox="0 0 16 16" class="w-full h-full" style="image-rendering: pixelated;">
                  <rect x="2" y="1" width="12" height="14" fill="#E44D26"/>
                  <rect x="3" y="2" width="10" height="12" fill="#F16529"/>
                  <rect x="5" y="5" width="6" height="1" fill="#FFFFFF"/>
                  <rect x="5" y="7" width="6" height="1" fill="#FFFFFF"/>
                  <rect x="5" y="9" width="4" height="1" fill="#FFFFFF"/>
                  <rect x="5" y="11" width="5" height="1" fill="#FFFFFF"/>
                </svg>
              )}
              {tech.nombre === 'CSS' && (
                <svg viewBox="0 0 16 16" class="w-full h-full" style="image-rendering: pixelated;">
                  <rect x="2" y="1" width="12" height="14" fill="#264DE4"/>
                  <rect x="3" y="2" width="10" height="12" fill="#2965F1"/>
                  <rect x="4" y="4" width="3" height="1" fill="#FFFFFF"/>
                  <rect x="4" y="6" width="3" height="1" fill="#FFFFFF"/>
                  <rect x="4" y="8" width="2" height="1" fill="#FFFFFF"/>
                  <rect x="4" y="10" width="4" height="1" fill="#FFFFFF"/>
                  <rect x="8" y="4" width="4" height="1" fill="#EBEBEB"/>
                  <rect x="8" y="6" width="4" height="1" fill="#EBEBEB"/>
                  <rect x="8" y="8" width="4" height="1" fill="#EBEBEB"/>
                  <rect x="8" y="10" width="4" height="1" fill="#EBEBEB"/>
                </svg>
              )}
              {tech.nombre === 'JS' && (
                <svg viewBox="0 0 16 16" class="w-full h-full" style="image-rendering: pixelated;">
                  <rect x="2" y="1" width="12" height="14" fill="#F7DF1E"/>
                  <rect x="3" y="2" width="10" height="12" fill="#F7DF1E"/>
                  <rect x="6" y="5" width="1" height="1" fill="#000000"/>
                  <rect x="8" y="4" width="1" height="1" fill="#000000"/>
                  <rect x="4" y="8" width="4" height="1" fill="#000000"/>
                  <rect x="5" y="9" width="3" height="1" fill="#000000"/>
                  <rect x="5" y="10" width="3" height="1" fill="#000000"/>
                  <rect x="9" y="9" width="1" height="2" fill="#000000"/>
                  <rect x="6" y="12" width="1" height="1" fill="#000000"/>
                  <rect x="8" y="11" width="3" height="1" fill="#000000"/>
                </svg>
              )}
              {tech.nombre === 'REACT' && (
                <svg viewBox="0 0 16 16" class="w-full h-full" style="image-rendering: pixelated;">
                  <rect x="2" y="1" width="12" height="14" fill="#61DAFB"/>
                  <rect x="3" y="2" width="10" height="12" fill="#61DAFB"/>
                  <circle cx="8" cy="8" r="3" fill="none" stroke="#282C34" stroke-width="1"/>
                  <circle cx="8" cy="2" r="1.5" fill="#282C34"/>
                  <circle cx="8" cy="14" r="1.5" fill="#282C34"/>
                  <circle cx="2" cy="8" r="1.5" fill="#282C34"/>
                  <circle cx="14" cy="8" r="1.5" fill="#282C34"/>
                </svg>
              )}
              {tech.nombre === 'ASTRO' && (
                <svg viewBox="0 0 16 16" class="w-full h-full" style="image-rendering: pixelated;">
                  <rect x="2" y="1" width="12" height="14" fill="#FF5A1F"/>
                  <rect x="3" y="2" width="10" height="12" fill="#FF5A1F"/>
                  <polygon points="8,4 11,8 8,12 5,8" fill="#FFFFFF"/>
                  <rect x="4" y="6" width="1" height="1" fill="#FF5A1F"/>
                  <rect x="11" y="6" width="1" height="1" fill="#FF5A1F"/>
                  <rect x="4" y="10" width="1" height="1" fill="#FF5A1F"/>
                  <rect x="11" y="10" width="1" height="1" fill="#FF5A1F"/>
                </svg>
              )}
            </div>
            <!-- Nombre tecnología -->
            <div class="font-pixel text-sm text-[#FFFFFF] mb-2">
              {tech.nombre}
            </div>
            <!-- Barra separadora -->
            <div class="w-8 h-0.5 bg-[#00E5FF] mb-2"></div>
            <!-- Descripción -->
            <p class="font-pixel text-[10px] sm:text-xs text-gray-400 text-center leading-tight">
              {tech.descripcion}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>