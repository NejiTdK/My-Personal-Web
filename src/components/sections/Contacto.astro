---
/**
 * Sección de contacto - Tarjetas con vanilla-tilt
 */
const baseUrl = import.meta.env.BASE_URL;

const contacts = [
  { 
    type: 'email', 
    label: 'Email', 
    value: 'alejandro.gardunocano@gmail.com',
    href: 'mailto:alejandro.gardunocano@gmail.com',
    color: '#AB1D1D'
  },
  { 
    type: 'github', 
    label: 'GitHub', 
    value: 'NejiTdK',
    href: 'https://github.com/NejiTdK',
    target: '_blank',
    color: '#94A6B5'
  },
  { 
    type: 'discord', 
    label: 'Discord', 
    value: 'neji_04',
    href: 'https://discord.com/users/neji_04',
    target: '_blank',
    color: '#5427F5'
  },
  { 
    type: 'whatsapp', 
    label: 'WhatsApp', 
    value: '55 3026 7102',
    href: 'https://wa.me/525530267102',
    target: '_blank',
    color: '#20913A'
  },
];
---

<section id="contacto" class="py-16 sm:py-24 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="font-pixel text-lg sm:text-xl text-[#00E5FF] mb-8 sm:mb-12">
      CONTACTO
    </h2>
    
    <p class="text-[#888888] text-sm sm:text-base mb-8">
      ¿Necesitás una landing page para tu negocio? Hablemos.
    </p>
    
    <div class="flex flex-col items-center gap-4">
      <!-- Email - fila completa -->
      <a 
        href={contacts[0].href}
        class="contact-card contact-card-email font-pixel"
        data-tilt
        data-tilt-max="15"
        data-tilt-speed="300"
        data-tilt-max-glare="0.2"
        data-contact-type="email"
      >
        <div class="contact-icon">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M22 6L12 13 2 6"/>
          </svg>
        </div>
        <div class="contact-info">
          <span class="contact-label">{contacts[0].label}</span>
          <span class="contact-value">{contacts[0].value}</span>
        </div>
      </a>
      
      <!-- Sociales - 3 tarjetas en fila -->
      <div class="flex flex-col sm:flex-row gap-4 w-full max-w-lg">
        <!-- GitHub -->
        <a 
          href={contacts[1].href}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card contact-card-social font-pixel"
          data-tilt
          data-tilt-max="15"
          data-tilt-speed="300"
          data-tilt-max-glare="0.2"
          data-contact-type="github"
        >
          <div class="contact-icon">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </div>
          <div class="contact-info">
            <span class="contact-label">{contacts[1].label}</span>
            <span class="contact-value">{contacts[1].value}</span>
          </div>
        </a>

        <!-- Discord -->
        <a 
          href={contacts[2].href}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card contact-card-social font-pixel"
          data-tilt
          data-tilt-max="15"
          data-tilt-speed="300"
          data-tilt-max-glare="0.2"
          data-contact-type="discord"
        >
          <div class="contact-icon">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </div>
          <div class="contact-info">
            <span class="contact-label">{contacts[2].label}</span>
            <span class="contact-value">{contacts[2].value}</span>
          </div>
        </a>

        <!-- WhatsApp -->
        <a 
          href={contacts[3].href}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card contact-card-social font-pixel"
          data-tilt
          data-tilt-max="15"
          data-tilt-speed="300"
          data-tilt-max-glare="0.2"
          data-contact-type="whatsapp"
        >
          <div class="contact-icon">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div class="contact-info">
            <span class="contact-label">{contacts[3].label}</span>
            <span class="contact-value">{contacts[3].value}</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base de las tarjetas */
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: #121212;
    border: 2px solid #2a2a2a;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    transform-style: preserve-3d;
    transform: perspective(1000px);
    font-family: inherit;
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
  }

  /* Tarjeta de email - más grande */
  .contact-card-email {
    justify-content: flex-start;
    padding: 1.25rem 2rem;
  }

  /* Tarjetas sociales - más pequeñas y centradas */
  .contact-card-social {
    flex: 1;
    justify-content: center;
    padding: 1rem;
    min-width: 100px;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-card-social .contact-info {
    align-items: center;
    text-align: center;
  }

  /* Efectos hover con colores específicos por tipo */
  .contact-card[data-contact-type="email"]:hover {
    border-color: #AB1D1D;
    box-shadow: 0 0 20px rgba(171, 29, 29, 0.4), inset 0 0 15px rgba(171, 29, 29, 0.15);
  }

  .contact-card[data-contact-type="email"]:hover .contact-icon {
    color: #AB1D1D;
    filter: drop-shadow(0 0 8px rgba(171, 29, 29, 0.8));
  }

  .contact-card[data-contact-type="email"]:hover .contact-value {
    color: #AB1D1D;
  }

  .contact-card[data-contact-type="github"]:hover {
    border-color: #94A6B5;
    box-shadow: 0 0 20px rgba(148, 166, 181, 0.4), inset 0 0 15px rgba(148, 166, 181, 0.15);
  }

  .contact-card[data-contact-type="github"]:hover .contact-icon {
    color: #94A6B5;
    filter: drop-shadow(0 0 8px rgba(148, 166, 181, 0.8));
  }

  .contact-card[data-contact-type="github"]:hover .contact-value {
    color: #94A6B5;
  }

  .contact-card[data-contact-type="discord"]:hover {
    border-color: #5427F5;
    box-shadow: 0 0 20px rgba(84, 39, 245, 0.4), inset 0 0 15px rgba(84, 39, 245, 0.15);
  }

  .contact-card[data-contact-type="discord"]:hover .contact-icon {
    color: #5427F5;
    filter: drop-shadow(0 0 8px rgba(84, 39, 245, 0.8));
  }

  .contact-card[data-contact-type="discord"]:hover .contact-value {
    color: #5427F5;
  }

  .contact-card[data-contact-type="whatsapp"]:hover {
    border-color: #20913A;
    box-shadow: 0 0 20px rgba(32, 145, 58, 0.4), inset 0 0 15px rgba(32, 145, 58, 0.15);
  }

  .contact-card[data-contact-type="whatsapp"]:hover .contact-icon {
    color: #20913A;
    filter: drop-shadow(0 0 8px rgba(32, 145, 58, 0.8));
  }

  .contact-card[data-contact-type="whatsapp"]:hover .contact-value {
    color: #20913A;
  }

  /* Icono */
  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888888;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .contact-card-email .contact-icon {
    width: 24px;
    height: 24px;
  }

  .contact-card-social .contact-icon {
    width: 20px;
    height: 20px;
  }

  /* Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    text-align: left;
    min-width: 0;
    flex: 1;
  }

  .contact-label {
    font-size: 10px;
    color: #888888;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  .contact-value {
    font-size: 12px;
    color: #FFFFFF;
    word-break: break-word;
    transition: color 0.3s ease;
  }

  .contact-card-social .contact-value {
    font-size: 11px;
  }

  .contact-card[data-tilt] {
    will-change: transform;
  }
</style>