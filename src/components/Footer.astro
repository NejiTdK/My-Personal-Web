---
/**
 * Pie de página del sitio con decoración pixel y copyright.
 */
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="py-8 px-4 border-t-2 border-[#00E5FF] relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
  
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-center md:text-left">
        <p class="font-pixel text-xs text-[#FFFFFF]">ALEC<span class="text-[#00E5FF]">DEV</span> © 2026</p>
        <p class="font-pixel text-xs text-[#888888] mt-1">Todos los derechos reservados</p>
      </div>
      
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-[#00E5FF]"></span>
          <span class="font-pixel text-xs text-[#888888]">READY TO WORK</span>
        </div>
        
        <div class="font-pixel text-xs text-[#888888]">
          v1.0.0
        </div>
      </div>
      
      <div class="text-center md:text-right">
        <p class="font-pixel text-xs text-[#00E5FF] hover:text-[#FFE500] transition-colors">Hecho con</p>
        <p class="font-pixel text-xs text-[#00E5FF] hover:text-[#FFE500] transition-colors mt-1">♥ y código</p>
      </div>
    </div>
    
    <div class="mt-6 pt-6 border-t border-[#333]">
      <div class="flex justify-center gap-2">
        {[...Array(20)].map((_, i) => (
          <span 
            class="w-2 h-2 bg-[#FFE500] pulse-glow" 
            style={`animation-delay: ${i * 0.1}s;`}
          ></span>
        ))}
      </div>
      
      <p class="font-pixel text-xs text-[#888888] mt-4 text-center">
        — ALEC<span class="text-[#00E5FF]">DEV</span> PORTFOLIO —
      </p>
    </div>
  </div>
</footer>