---
/**
 * Página de proyectos del portafolio AlecDev.
 * Muestra un grid de proyectos con tarjetas React + Live Preview modal.
 * 
 * Cada proyecto puede incluir:
 * - `id`: identificador único
 * - `title`: título del proyecto
 * - `description`: descripción breve
 * - `year`: año de creación
 * - `technologies`: array de tecnologías usadas ['html', 'css', 'js', 'postcss', 'react', 'astro']
 * - `thumbnail`: ruta a la imagen de miniatura (en /public)
 * - `demoUrl`: ruta al demo HTML (en /public/demos/) - opcional
 * - `hasDemo`: boolean que habilita el botón de Live Preview - opcional
 */
import Layout from '../layouts/Layout.astro';
import PixelNav from '../components/sections/PixelNav.astro';
import Footer from '../components/sections/Footer.astro';
import ProjectCard from '../components/features/ProjectCard';
import { pages } from '../config/seo';

/** Lista de proyectos del portafolio */
const projects = [
  {
    id: 'prototipo-landing',
    title: 'Prototipo Landing',
    description: 'Prototipado de landing page construida para una constructora.',
    year: '2026',
    technologies: ['html', 'css', 'js'],
    thumbnail: 'projects/proyecto-a-large.webp',
    demoUrl: 'demos/prototipo-landing/index.html',  // Demo en /public/demos/
    hasDemo: true  // Habilita el botón de Live Preview
  }
  // Para añadir más proyectos:
  // {
  //   id: 'mi-proyecto',
  //   title: 'Mi Proyecto',
  //   description: 'Descripción del proyecto...',
  //   year: '2026',
  //   technologies: ['html', 'css', 'js', 'react'],
  //   thumbnail: 'projects/mi-thumb.webp',
  //   demoUrl: 'demos/mi-proyecto/index.html',
  //   hasDemo: true
  // }
];

/** URL base del sitio (importante para GitHub Pages) */
const baseUrl = import.meta.env.BASE_URL;

// Obtener query de búsqueda desde URL
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get('q')?.toLowerCase() || '';

// Filtrar proyectos si hay query
const filteredProjects = searchQuery
  ? projects.filter(p => p.title.toLowerCase().includes(searchQuery))
  : projects;
---

<Layout 
  title={pages.proyectos.title}
  description={pages.proyectos.description}
>  <PixelNav />
   
  <main class="relative min-h-screen pt-20 sm:pt-24">
    <section class="py-8 sm:py-12 px-3 sm:px-4">
      <div class="max-w-lg mx-auto">
        <div class="text-center mb-8 sm:mb-12">
          <h1 class="font-pixel text-xl sm:text-2xl md:text-3xl text-[#FFFFFF] mb-2 sm:mb-4">
            {searchQuery ? `BUSCANDO: "${searchQuery.toUpperCase()}"` : 'PROYECTOS'}
          </h1>
          <p class="font-pixel text-[10px] sm:text-xs text-[#888888]">
            {searchQuery 
              ? `${filteredProjects.length} resultado${filteredProjects.length !== 1 ? 's' : ''} encontrado${filteredProjects.length !== 1 ? 's' : ''}` 
              : 'Mis trabajos y criaturas'}
          </p>
        </div>

{filteredProjects.length === 0 ? (
          <div className="text-center py-16 sm:py-20">
            <p className="font-pixel text-xs sm:text-sm text-[#888888]">
              {searchQuery ? `No se encontraron proyectos con "${searchQuery}"` : 'Sin proyectos aún'}
            </p>
            {searchQuery && (
              <a href={`${baseUrl}proyectos/`} className="font-pixel text-xs text-[#00E5FF] hover:text-[#FFE500] mt-2 inline-block">
                Ver todos los proyectos →
              </a>
            )}
          </div>
        ) : (
          <div className="space-y-6 sm:space-y-8">
            {filteredProjects.map((project) => (
              <ProjectCard 
                client:load 
                project={project} 
                baseUrl={baseUrl} 
              />
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>