---
/**
 * Galería de proyectos del portafolio.
 * Pertenece a: `src/pages/proyectos.astro` → ruta `/proyectos`.
 *
 * Muestra una lista de `posts` (imagen + descripción). Si el array está vacío,
 * se muestra el estado vacío. Incluye un modal carrusel para ampliar imágenes
 * cuando hay elementos (script al final del archivo).
 */
import Layout from '../layouts/Layout.astro';
import PixelNav from '../components/PixelNav.astro';
import Footer from '../components/Footer.astro';

/** Formato de cada entrada de proyecto en la galería. */
interface Post {
  src: string;
  description: string;
}

/** Colección de proyectos; añade objetos `{ src, description }` para poblar la página. */
const posts: Post[] = [];
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="AlecDev | Proyectos">
  <PixelNav />
  
  <main class="relative min-h-screen">
    <!-- `pt-20` compensa la altura de la navegación fija. -->
    <section class="py-12 px-4">
      <div class="max-w-lg mx-auto">
        <!-- Cabecera de la sección -->
        <div class="text-center mb-12">
          <h1 class="font-pixel text-2xl md:text-3xl text-[#EDEDED] mb-4">
            PROYECTOS
          </h1>
          <p class="font-pixel text-xs text-[#DDE8EB]/60">
            Mis trabajos y creaciones
          </p>
        </div>

        {posts.length === 0 ? (
          <!-- Estado sin proyectos: mensaje placeholder hasta que existan entradas. -->
          <div class="text-center py-20">
            <p class="font-pixel text-sm text-[#DDE8EB]/50">
              Sin proyectos aún
            </p>
          </div>
        ) : (
          <!-- Tarjetas estilo feed: avatar, imagen clicable y descripción. -->
          <div class="space-y-6">
            {posts.map((post, index) => (
              <article class="bg-[#0a0a12] border border-[#333] overflow-hidden">
                <!-- Cabecera tipo “perfil” con logo del sitio -->
                <div class="flex items-center gap-3 px-4 py-3 border-b border-[#333]">
                  <div class="w-8 h-8 border border-[#0D8BDB] overflow-hidden flex-shrink-0">
                    <img src={`${baseUrl}logo.png`} alt="AlecDev" class="w-full h-full object-contain" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-pixel text-xs text-[#EDEDED]">ALEC<span class="text-[#0D8BDB]">DEV</span></p>
                  </div>
                </div>

                <!-- Imagen del proyecto: `data-index` enlaza con el carrusel modal. -->
                <div class="aspect-square bg-[#0d1b2a] cursor-pointer post-image" data-index={index}>
                  <img src={post.src} alt="" class="w-full h-full object-contain" loading="lazy" />
                </div>

                <!-- Texto descriptivo del proyecto -->
                <div class="px-4 py-3">
                  <p class="font-pixel text-xs text-[#DDE8EB]/90 leading-relaxed">
                    <span class="text-[#EDEDED] font-bold mr-2">ALEC<span class="text-[#0D8BDB]">DEV</span></span>
                    {post.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <!-- Modal fullscreen: navegación prev/sig, cierre y contador. Oculto por defecto (`hidden`). -->
  <div id="carousel-modal" class="fixed inset-0 bg-black/95 z-50 hidden flex items-center justify-center">
    <button id="carousel-close" class="absolute top-4 right-4 w-12 h-12 bg-[#0D8BDB] hover:bg-[#1eb3ff] transition-colors font-pixel text-xl flex items-center justify-center z-10">
      ×
    </button>
    
    <button id="carousel-prev" class="absolute left-4 w-12 h-12 bg-[#06476F] hover:bg-[#0D8BDB] transition-colors font-pixel text-xl flex items-center justify-center">
      ‹
    </button>
    
    <button id="carousel-next" class="absolute right-4 w-12 h-12 bg-[#06476F] hover:bg-[#0D8BDB] transition-colors font-pixel text-xl flex items-center justify-center">
      ›
    </button>

    <div class="max-w-5xl max-h-[80vh] relative">
      <img id="carousel-image" src="" alt="" class="max-w-full max-h-[80vh] object-contain" />
      
      <div id="carousel-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black/50 px-4 py-2 font-pixel text-xs text-[#EDEDED]">
        1 / 1
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  /** Índice de la imagen actualmente visible en el carrusel modal. */
  let carouselIndex = 0;

  /** Nodos del DOM usados por la galería y el modal. */
  const images = Array.from(document.querySelectorAll('.post-image')) as HTMLElement[];
  const carouselModal = document.getElementById('carousel-modal')!;
  const carouselImage = document.getElementById('carousel-image') as HTMLImageElement;
  const carouselCounter = document.getElementById('carousel-counter')!;

  if (images.length > 0) {
    images.forEach(item => {
      item.addEventListener('click', () => {
        carouselIndex = parseInt(item.getAttribute('data-index')!);
        openCarousel();
      });
    });
  }

  /** Abre el modal y muestra la imagen según `carouselIndex`. */
  function openCarousel() {
    const img = images[carouselIndex].querySelector('img') as HTMLImageElement;
    carouselImage.src = img.src;
    carouselCounter.textContent = `${carouselIndex + 1} / ${images.length}`;
    carouselModal.classList.remove('hidden');
    carouselModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  /** Cierra el modal y restaura el scroll del body. */
  function closeCarousel() {
    carouselModal.classList.add('hidden');
    carouselModal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  /** Avanza al siguiente proyecto (circular). */
  function nextImage() {
    carouselIndex = (carouselIndex + 1) % images.length;
    const img = images[carouselIndex].querySelector('img') as HTMLImageElement;
    carouselImage.src = img.src;
    carouselCounter.textContent = `${carouselIndex + 1} / ${images.length}`;
  }

  /** Retrocede al proyecto anterior (circular). */
  function prevImage() {
    carouselIndex = (carouselIndex - 1 + images.length) % images.length;
    const img = images[carouselIndex].querySelector('img') as HTMLImageElement;
    carouselImage.src = img.src;
    carouselCounter.textContent = `${carouselIndex + 1} / ${images.length}`;
  }

  document.getElementById('carousel-close')?.addEventListener('click', closeCarousel);
  document.getElementById('carousel-next')?.addEventListener('click', nextImage);
  document.getElementById('carousel-prev')?.addEventListener('click', prevImage);
  carouselModal?.addEventListener('click', (e) => { if (e.target === carouselModal) closeCarousel(); });
  document.addEventListener('keydown', (e) => {
    if (carouselModal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeCarousel();
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
  });
</script>
