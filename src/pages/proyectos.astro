---
import Layout from '../layouts/Layout.astro';
import PixelNav from '../components/PixelNav.astro';
import Footer from '../components/Footer.astro';

interface Post {
  src: string;
  description: string;
}

const posts: Post[] = [];
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="AlecDev | Proyectos">
  <PixelNav />
  
  <main class="relative min-h-screen">
    <section class="py-8 sm:py-12 px-3 sm:px-4">
      <div class="max-w-lg mx-auto">
        <div class="text-center mb-8 sm:mb-12">
          <h1 class="font-pixel text-xl sm:text-2xl md:text-3xl text-[#FFFFFF] mb-2 sm:mb-4">
            PROYECTOS
          </h1>
          <p class="font-pixel text-[10px] sm:text-xs text-[#888888]">
            Mis trabajos y creaciones
          </p>
        </div>

        {posts.length === 0 ? (
          <div class="text-center py-16 sm:py-20">
            <p class="font-pixel text-xs sm:text-sm text-[#888888]">
              Sin proyectos aún
            </p>
          </div>
        ) : (
          <div class="space-y-4 sm:space-y-6">
            {posts.map((post, index) => (
              <article class="bg-[#0a0a0a] border-2 border-[#00E5FF] overflow-hidden" style="box-shadow: 4px 4px 0 #00E5FF;">
                <div class="flex items-center gap-2 sm:gap-3 px-3 sm:px-4 py-2 sm:py-3 border-b border-[#333]">
                  <div class="w-8 h-8 border-2 border-[#00E5FF] overflow-hidden flex-shrink-0">
                    <img src={`${baseUrl}logo.png`} alt="AlecDev" class="w-full h-full object-contain" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-pixel text-xs text-[#FFFFFF]">ALEC<span class="text-[#00E5FF]">DEV</span></p>
                  </div>
                </div>

                <div class="max-h-64 sm:max-h-80 md:max-h-96 bg-[#0a0a0a] cursor-pointer post-image overflow-hidden" data-index={index}>
                  <img src={post.src} alt="" class="w-full h-full object-contain max-h-full" loading="lazy" />
                </div>

                <div class="px-3 sm:px-4 py-2 sm:py-3">
                  <p class="font-pixel text-[10px] sm:text-xs text-[#888888] leading-relaxed">
                    <span class="text-[#FFFFFF] mr-2">ALEC<span class="text-[#00E5FF]">DEV</span></span>
                    {post.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <div id="carousel-modal" class="fixed inset-0 bg-black/95 z-50 hidden flex items-center justify-center p-2">
    <button id="carousel-close" class="absolute top-2 sm:top-4 right-2 sm:right-4 w-10 sm:w-12 h-10 sm:h-12 bg-[#00E5FF] hover:bg-[#FFE500] transition-colors font-pixel text-lg sm:text-xl flex items-center justify-center text-[#000000] z-10">
      ×
    </button>
    
    <button id="carousel-prev" class="absolute left-2 sm:left-4 w-10 sm:w-12 h-10 sm:h-12 bg-[#00E5FF] hover:bg-[#FFE500] transition-colors font-pixel text-lg sm:text-xl flex items-center justify-center text-[#000000]">
      ‹
    </button>
    
    <button id="carousel-next" class="absolute right-2 sm:right-4 w-10 sm:w-12 h-10 sm:h-12 bg-[#00E5FF] hover:bg-[#FFE500] transition-colors font-pixel text-lg sm:text-xl flex items-center justify-center text-[#000000]">
      ›
    </button>

    <div class="max-w-full max-h-[80vh] relative px-8 sm:px-16">
      <img id="carousel-image" src="" alt="" class="max-w-full max-h-[70vh] sm:max-h-[80vh] object-contain" />
      
      <div id="carousel-counter" class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 bg-black/50 px-3 sm:px-4 py-1 sm:py-2 font-pixel text-[10px] sm:text-xs text-[#FFFFFF]">
        1 / 1
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  let carouselIndex = 0;

  const images = Array.from(document.querySelectorAll('.post-image')) as HTMLElement[];
  const carouselModal = document.getElementById('carousel-modal')!;
  const carouselImage = document.getElementById('carousel-image') as HTMLImageElement;
  const carouselCounter = document.getElementById('carousel-counter')!;

  if (images.length > 0) {
    images.forEach(item => {
      item.addEventListener('click', () => {
        carouselIndex = parseInt(item.getAttribute('data-index')!);
        openCarousel();
      });
    });
  }

  function openCarousel() {
    const img = images[carouselIndex].querySelector('img') as HTMLImageElement;
    carouselImage.src = img.src;
    carouselCounter.textContent = `${carouselIndex + 1} / ${images.length}`;
    carouselModal.classList.remove('hidden');
    carouselModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeCarousel() {
    carouselModal.classList.add('hidden');
    carouselModal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function nextImage() {
    carouselIndex = (carouselIndex + 1) % images.length;
    const img = images[carouselIndex].querySelector('img') as HTMLImageElement;
    carouselImage.src = img.src;
    carouselCounter.textContent = `${carouselIndex + 1} / ${images.length}`;
  }

  function prevImage() {
    carouselIndex = (carouselIndex - 1 + images.length) % images.length;
    const img = images[carouselIndex].querySelector('img') as HTMLImageElement;
    carouselImage.src = img.src;
    carouselCounter.textContent = `${carouselIndex + 1} / ${images.length}`;
  }

  document.getElementById('carousel-close')?.addEventListener('click', closeCarousel);
  document.getElementById('carousel-next')?.addEventListener('click', nextImage);
  document.getElementById('carousel-prev')?.addEventListener('click', prevImage);
  carouselModal?.addEventListener('click', (e) => { if (e.target === carouselModal) closeCarousel(); });
  document.addEventListener('keydown', (e) => {
    if (carouselModal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeCarousel();
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
  });
</script>