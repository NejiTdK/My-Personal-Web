---
/**
 * Página de inicio del portafolio AlecDev.
 * Pertenece a: `src/pages/index.astro` → ruta `/` en el sitio generado.
 *
 * Orquesta el layout principal, navegación fija, héroe, sección de estadísticas/bio y pie.
 */
import Layout from '../layouts/Layout.astro';
import PixelNav from '../components/sections/PixelNav.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import SobreMi from '../components/sections/SobreMi.astro';
import Servicios from '../components/sections/Servicios.astro';
import ProyectosCTA from '../components/sections/ProyectosCTA.astro';
import Footer from '../components/sections/Footer.astro';
import Contacto from '../components/sections/Contacto.astro';
import { pages } from '../config/seo';

/** URL base del sitio (importante para GitHub Pages) */
const baseUrl = import.meta.env.BASE_URL;
---

<Layout 
  title={pages.home.title}
  description={pages.home.description}
>
  <!-- Barra de navegación fija superior (compartida con otras páginas). -->
  <PixelNav />
  
  <main class="relative">
    <!-- Bloque principal: logo, título, tagline y CTA hacia #sobre-mi. -->
    <HeroSection 
      name="ALECDEV"
      title="Creador de Sitios Web"
      tagline="Creo landing pages que convierten. Sitios estáticos, rápidos y optimizados para tu negocio."
    />
    
    <!-- Sobre Mí - Diseño limpio -->
    <SobreMi />
    
    <!-- Servicios -->
    <Servicios />
    
    <!-- CTA Proyectos -->
    <ProyectosCTA />
    
    <!-- Contacto -->
    <Contacto />
  </main>
  
  <!-- Pie de página con copyright y decoración pixel. -->
  <Footer />
</Layout>
