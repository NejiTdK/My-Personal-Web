---
/**
 * Página de inicio del portafolio AlecDev.
 * Pertenece a: `src/pages/index.astro` → ruta `/` en el sitio generado.
 *
 * Orquesta el layout principal, navegación fija, héroe, sección de estadísticas/bio y pie.
 */
import Layout from '../layouts/Layout.astro';
import PixelNav from '../components/PixelNav.astro';
import HeroSection from '../components/HeroSection.astro';
import StatsSection from '../components/StatsSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="AlecDev | Portafolio Retro">
  <!-- Barra de navegación fija superior (compartida con otras páginas). -->
  <PixelNav />
  
  <main class="relative">
    <!-- Bloque principal: logo, título, tagline y CTA hacia #sobre-mi. -->
    <HeroSection 
      name="ALECDEV"
      title="Desarrollador Front-end"
      tagline="Desarrollador front-end jr, entusiasta del desarrollo y transformación de ideas en proyectos con el uso de IA"
    />
    
    <!-- Perfil estilo consola: datos y bio -->
    <StatsSection />
  </main>
  
  <!-- Pie de página con copyright y decoración pixel. -->
  <Footer />
</Layout>
